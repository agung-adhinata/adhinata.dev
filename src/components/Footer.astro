---
const today = new Date();
---

<footer
  class="flex w-full flex-col items-center bg-neutral-100 transition-colors duration-500 dark:bg-neutral-800"
>
  <section
    class="flex w-full grow justify-center bg-white px-8 py-2 transition-colors duration-300 dark:bg-black"
  >
    <span class="flex max-w-4xl grow">
      <div class="grow"></div>
      <div class="flex flex-col opacity-80">
        <p>Privacy Policy</p>
        <p>Klocation</p>
      </div>
    </span>
  </section>
  <section class="flex w-full max-w-4xl justify-between px-8 py-8">
    <div class="flex items-end gap-6">
      <img src="/favicon2.svg" class="size-8" alt="icon" />
      <div class="flex flex-col">
        <p class="font-mono text-xs opacity-30">NEKKIICHI - LITHINUX - NE__.</p>
        <p
          class="flex items-center gap-4 p-0 font-mono leading-none opacity-80"
        >
          <strong>
            &copy; {today.getFullYear()} Adhinata.DEV.
          </strong>
          <span class="text-sm font-light">All rights reserved.</span>
        </p>
      </div>
    </div>
  </section>
</footer>
