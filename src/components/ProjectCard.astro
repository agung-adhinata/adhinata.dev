---
import type { Project } from "@/data/projects";

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<article class="not-prose group flex flex-col gap-3 rounded-none border border-neutral-200 bg-white/60 p-5 transition-all duration-200 hover:border-amber-500/60 hover:shadow-sm dark:border-neutral-800 dark:bg-neutral-900/60 dark:hover:border-amber-400/60">
  <div class="flex flex-wrap items-baseline justify-between gap-2">
    <div class="flex flex-wrap items-center gap-2">
      <h3 class="text-lg font-semibold tracking-tight text-neutral-900 dark:text-neutral-100">
        {project.title}
      </h3>
      <span class="rounded-md bg-amber-500/10 px-2 py-0.5 text-xs font-medium text-amber-700 dark:bg-amber-400/10 dark:text-amber-300">
        {project.year}
      </span>
    </div>
    <span class="text-xs font-medium text-neutral-500 dark:text-neutral-400">
      {project.role}
    </span>
  </div>

  <p class="text-xs italic text-neutral-500 dark:text-neutral-400">
    {project.collaboration}
  </p>

  <p class="text-sm leading-relaxed text-neutral-700 dark:text-neutral-300">
    {project.description}
  </p>

  <div class="flex flex-wrap gap-1.5 pt-1">
    {project.tags.map((tag) => (
      <span class="rounded bg-neutral-100 px-2 py-0.5 text-xs text-neutral-600 transition-colors dark:bg-neutral-800 dark:text-neutral-300">
        {tag}
      </span>
    ))}
  </div>

  {project.links && project.links.length > 0 && (
    <div class="flex flex-wrap items-center gap-4 pt-2 border-t border-neutral-100 text-sm font-medium dark:border-neutral-800/80">
      {project.links.map((link) => (
        <a
          href={link.url}
          target={link.url.startsWith("http") ? "_blank" : undefined}
          rel={link.url.startsWith("http") ? "noopener noreferrer" : undefined}
          class="inline-flex items-center gap-1 text-neutral-600 transition-colors hover:text-amber-600 dark:text-neutral-400 dark:hover:text-amber-400"
        >
          <span class="">{link.label}</span>
          <span class="material-symbols-outlined text-[13px] leading-none">
            {link.label.toLowerCase().includes("source") ||
            link.label.toLowerCase().includes("code")
              ? "code"
              : link.label.toLowerCase().includes("figma")
                ? "palette"
                : "open_in_new"}
          </span>
        </a>
      ))}
    </div>
  )}
</article>
