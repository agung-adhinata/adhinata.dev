---
import type { Project } from "@/data/projects";

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<!-- Card type sizes intentionally mirror the article's `prose lg:prose-lg` scale:
     title = prose h3 (20px -> 24px), description = prose p (16px -> 18px). -->
<article class="flex flex-col gap-3 border border-neutral-200 bg-white p-5 text-base lg:gap-4 lg:p-6 lg:text-lg dark:border-neutral-700 dark:bg-neutral-800/40">
  <section class="flex flex-col">
    <div class="flex w-full justify-between">
      <span class="font-medium text-sm text-neutral-600 dark:text-neutral-300">
        {project.role}
      </span>
      <span class="font-medium text-sm text-neutral-600 dark:text-neutral-300">
        {project.year}
      </span>
    </div>
    <div class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1">
      <h3 class="leading-8 font-semibold text-balance text-neutral-900 lg:text-2xl lg:leading-9 dark:text-white">
        {project.title}
      </h3>
    </div>
    <p class="text-sm leading-relaxed text-neutral-500 dark:text-neutral-400">
      {project.collaboration}
    </p>
  </section>

  <p class="prose text-base text-pretty text-neutral-700 dark:text-neutral-300">
    {project.description}
  </p>

  <ul class="flex flex-wrap gap-1.5 pt-1">
    {project.tags.map((tag) => (
      <li class="rounded-xs bg-neutral-100 px-2 py-0.5 text-xs text-neutral-600 dark:bg-neutral-800 dark:text-neutral-300">
        {tag}
      </li>
    ))}
  </ul>

  {project.links && project.links.length > 0 && (
    <div class="flex flex-wrap items-center gap-4 border-t border-neutral-100 pt-2 text-sm font-medium dark:border-neutral-700/60">
      {project.links.map((link) => (
        <a
          href={link.url}
          target={link.url.startsWith("http") ? "_blank" : undefined}
          rel={link.url.startsWith("http") ? "noopener noreferrer" : undefined}
          class="inline-flex items-center gap-1 text-neutral-600 underline-offset-4 transition-colors hover:text-amber-600 hover:underline dark:text-neutral-400 dark:hover:text-amber-400"
        >
          <span>{link.label}</span>
          <span class="material-symbols-outlined text-[1em] leading-none">
            {link.label.toLowerCase().includes("source") ||
            link.label.toLowerCase().includes("code")
              ? "code"
              : link.label.toLowerCase().includes("figma")
                ? "palette"
                : "open_in_new"}
          </span>
        </a>
      ))}
    </div>
  )}
</article>
