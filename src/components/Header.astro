---
import { SITE_TITLE } from "../consts";
import HeaderLink from "./HeaderLink.astro";
import { DarkModeToggle } from "./react/DarkModeToggle";
import HeaderIcon from "./react/HeaderIcon";
---

<header
  class="sticky top-0 flex w-full flex-row bg-white/70 p-2 backdrop-blur-xl dark:bg-neutral-900/70 border-b-2 "
>
  <nav class="relative flex min-h-10 grow items-center justify-center">
    <section class="absolute top-0 bottom-0 left-0 flex items-center">
      <HeaderIcon client:load/>
    </section>
    <div class="flex gap-4">
      <HeaderLink href="/">Home</HeaderLink>
      <HeaderLink href="/blog">Blog</HeaderLink>
      <HeaderLink href="/about">About</HeaderLink>
    </div>
    <section class="absolute top-0 right-0 bottom-0 flex items-center gap-2">
      <DarkModeToggle client:only="react" />
    </section>
  </nav>
</header>
