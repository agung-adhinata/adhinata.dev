---
import { SITE_DESCRIPTION, SITE_TITLE } from "@/consts";
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
  title={SITE_TITLE}
  description={SITE_DESCRIPTION}
  mainClass="max-w-2xl justify-center px-8"
>
  <section class="prose dark:prose-invert">
    <span class="flex w-full justify-center">
      <h1 class="mb-4">Agung Adhinata</h1>
    </span>
    <h2 class="mt-0">Android & React Native Developer | OSM Contributor</h2>
    <p>Hi, my name is Agung Adhinata, I'm self taught developer.</p>
    <p>
      This is my personal website that include my portofoio, project, and
      personal blog.
    </p>
    <p>
      You can access it from the navigation bar above or from my own overview
    </p>
  </section>
</BaseLayout>
