---
// Layout for static/prose pages (About, 404, etc.).
// Use BlogPostLayout for content collection entries instead.
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import BaseLayout from "./BaseLayout.astro";

interface Props {
  title: string;
  description: string;
  /** Optional hero image, also used as the social sharing image. */
  heroImage?: ImageMetadata;
}

const { title, description, heroImage } = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  image={heroImage}
  mainClass="justify-center px-8"
>
  <article class="flex w-full max-w-3xl flex-col items-center py-8">
    {
      heroImage && (
        <Image
          width={1020}
          height={510}
          src={heroImage}
          alt={title}
          class="w-full rounded-2xl"
        />
      )
    }
    <div
      class:list={[
        "prose w-full lg:prose-lg dark:prose-invert",
        heroImage && "mt-8",
      ]}
    >
      <slot />
    </div>
  </article>
</BaseLayout>
